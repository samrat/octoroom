					stroke-dashoffset: -24;
				}
			}

			.eq-bar {
				transform-box: fill-box;
				transform-origin: center bottom;
				animation: eqPulse 0.95s ease-in-out infinite;
			}

			.eq-bar.b2 {
				animation-delay: 0.16s;
			}
			.eq-bar.b3 {
				animation-delay: 0.32s;
			}
			.eq-bar.b4 {
				animation-delay: 0.2s;
			}

			.peer-group.dimmed .eq-bar {
				animation: none;
				opacity: 0.25;
			}

			@keyframes eqPulse {
				0%,
				100% {
					transform: scaleY(0.35);
				}
				50% {
					transform: scaleY(1);
				}
			}

			.wave-footer {
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 0.55rem 0.75rem;
				display: grid;
				grid-template-columns: auto 1fr auto;
				align-items: center;
				gap: 0.75rem;
			}

			.cf-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: var(--font-mono);
				font-size: 0.71rem;
				font-weight: 600;
				color: var(--text);
				white-space: nowrap;
			}

			.cf-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				background: var(--cf);
			}

			.live-wave-box {
				overflow: hidden;
				height: 22px;
			}

			.live-wave-svg {
				width: 200%;
				height: 22px;
				animation: slideWave 3.8s linear infinite;
			}

			@keyframes slideWave {
				from {
					transform: translateX(0);
				}
				to {
					transform: translateX(-50%);
				}
			}

			.route-code {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--accent-text);
				background: var(--accent-soft);
				border: 1px solid var(--accent-soft-border);
				padding: 0.2rem 0.55rem;
				border-radius: 6px;
				white-space: nowrap;
			}

			/* Code Section (moved below the fold) */
			.code-section,
			.examples-section {
				padding: 4.25rem 0;
				border-bottom: 1px solid var(--border);
				background: var(--bg-elev);
			}

			.features-section {
				padding: 4.25rem 0;
				border-bottom: 1px solid var(--border);
				background: var(--bg);
			}

			.section-head {
				margin-bottom: 2.25rem;
			}

			.section-head h2 {
				font-size: clamp(1.5rem, 2.5vw, 2.1rem);
				letter-spacing: -0.025em;
				margin: 0;
				max-width: 30ch;
			}

			.code-panel {
				background: var(--bg-code);
				border: 1px solid var(--code-border);
				border-radius: 14px;
				overflow: hidden;
				box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
			}

			.code-tabs {
				display: flex;
				gap: 0.25rem;
				padding: 0.6rem 0.75rem 0;
				background: var(--code-bar);
				border-bottom: 1px solid var(--code-border);
				overflow-x: auto;
			}

			.tab {
				background: transparent;
				border: none;
				border-bottom: 2px solid transparent;
				color: #a8a29e;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				padding: 0.5rem 0.75rem 0.6rem;
				cursor: pointer;
				white-space: nowrap;
			}

			.tab:hover {
				color: #f7f5f3;
			}

			.tab.active {
				color: #ffffff;
				border-bottom-color: #53eafd;
			}

			.code-slot :global(pre.astro-code) {
				margin: 0;
				padding: 1.25rem;
				background-color: var(--bg-code) !important;
				font-size: 0.83rem;
				line-height: 1.65;
				overflow-x: auto;
			}

			.hidden {
				display: none;
			}

			.feature-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
			}

			.feature-card {
				background: var(--bg-elev);
				border: 1px solid var(--border);
				border-radius: 12px;
				padding: 1.35rem;
			}

			.feature-card h3 {
				margin: 0 0 0.5rem;
				font-size: 1.02rem;
				letter-spacing: -0.015em;
			}

			.feature-card p {
				margin: 0;
				font-size: 0.91rem;
				color: var(--muted);
			}

			.examples-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.15rem;
			}

			.example-card {
				background: var(--bg-card);
				border: 1px solid var(--border);
				border-radius: 12px;
				padding: 1.25rem;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}

			.example-card:hover {
				border-color: var(--accent-text);
				transform: translateY(-1px);
			}

			.example-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
			}

			.example-top code {
				font-weight: 600;
				font-size: 0.88rem;
			}

			.example-tag {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				background: var(--accent-soft);
				border: 1px solid var(--accent-soft-border);
				color: var(--accent-text);
				white-space: nowrap;
			}

			.example-card p {
				margin: 0;
				font-size: 0.89rem;
				color: var(--muted);
			}

			.footer {
				padding: 2.25rem 0;
				font-size: 0.88rem;
				color: var(--muted);
				background: var(--bg);
			}

			.footer-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.footer-links {
				display: flex;
				gap: 1.25rem;
			}

			.footer-links a:hover {
				color: var(--text);
			}

			@media (prefers-reduced-motion: reduce) {
				.edge.lit,
				.edge.lit-cyan,
				.live-wave-svg,
				.eq-bar {
					animation: none !important;
				}
			}

			@media (max-width: 960px) {
				.hero-grid {
					grid-template-columns: 1fr;
				}
				.feature-grid,
				.examples-grid {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 640px) {
				.nav-links a:not(:first-child):not(.nav-github) {
					display: none;
				}
				.nav-github span {
					display: none;
				}
				.wave-footer {
					grid-template-columns: 1fr;
					gap: 0.45rem;
				}
				.feature-grid,
				.examples-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
