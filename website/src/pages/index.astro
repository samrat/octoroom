		<script is:inline>
			// Code section tabs
			const tabs = document.querySelectorAll('[data-tab]');
			const panels = document.querySelectorAll('[data-panel]');
			tabs.forEach((tab) => {
				tab.addEventListener('click', () => {
					const target = tab.getAttribute('data-tab');
					tabs.forEach((t) => {
						const active = t === tab;
						t.classList.toggle('active', active);
						t.setAttribute('aria-selected', String(active));
					});
					panels.forEach((p) => {
						p.classList.toggle('hidden', p.getAttribute('data-panel') !== target);
					});
				});
			});

			// Interactive-on-hover Group Call routing graph
			const graph = document.getElementById('routing-graph');
			const nodes = document.querySelectorAll('.interactive-node');
			const edges = {
				ada: document.getElementById('e-ada'),
				sam: document.getElementById('e-sam'),
				ai: document.getElementById('e-ai'),
				rec: document.getElementById('e-rec'),
				vision: document.getElementById('e-vision'),
			};
			const peerEls = {
				ada: document.getElementById('peer-ada'),
				sam: document.getElementById('peer-sam'),
				ai: document.getElementById('peer-ai'),
				rec: document.getElementById('peer-rec'),
			};
			const routeCode = document.getElementById('route-code');
			const graphHint = document.getElementById('graph-hint');

			const HOVER_STATES = {
				default: {
					lit: ['ada', 'sam', 'ai', 'rec'],
					cyan: [],
					activePeers: ['ada', 'sam', 'ai', 'rec'],
					focused: null,
					code: 'default_subscriptions/2 · 4 peers',
					hint: 'Hover a peer to inspect tracks',
				},
				ada: {
					lit: ['ada', 'sam', 'ai', 'rec'],
					cyan: ['vision'],
					activePeers: ['ada', 'sam', 'ai', 'rec'],
					focused: 'ada',
					code: 'Ada → mic, cam · hears Sam, Assistant',
					hint: 'Browser publishes mic + camera via SFU',
				},
				sam: {
					lit: ['sam', 'ada', 'ai', 'rec'],
					cyan: [],
					activePeers: ['sam', 'ada', 'ai', 'rec'],
					focused: 'sam',
					code: 'Sam → mic · hears Ada, Assistant',
					hint: 'Swift SDK joins the same Phoenix channel',
				},
				ai: {
					lit: ['ai', 'ada', 'sam'],
					cyan: ['vision'],
					activePeers: ['ai', 'ada', 'sam'],
					focused: 'ai',
					code: 'Assistant ← hears: [mics], sees: [cam]',
					hint: 'AI Agent opens outbound WebRTC to SFU',
				},
				rec: {
					lit: ['rec', 'ada', 'sam', 'ai'],
					cyan: [],
					activePeers: ['rec', 'ada', 'sam', 'ai'],
					focused: 'rec',
					code: 'Recorder ← PCM inputs (data-only)',
					hint: 'Server worker receives raw s16le PCM',
				},
				sfu: {
					lit: ['ada', 'sam', 'ai', 'rec'],
					cyan: ['vision'],
					activePeers: ['ada', 'sam', 'ai', 'rec'],
					focused: 'sfu',
					code: 'Cloudflare SFU · outbound UDP · 0 open ports',
					hint: 'Media survives Phoenix deploys & restarts',
				},
			};

			function applyHover(key) {
				const state = HOVER_STATES[key] || HOVER_STATES.default;
				Object.entries(edges).forEach(([k, el]) => {
					if (!el) return;
					const isLit = state.lit.includes(k);
					const isCyan = state.cyan.includes(k);
					const isPrimary = state.focused && state.focused === k;
					el.setAttribute(
						'class',
						'edge' +
							(k === 'vision' ? ' edge-vision' : '') +
							(isLit ? ' lit' : '') +
							(isCyan ? ' lit-cyan' : '') +
							(isPrimary ? ' primary-edge' : ''),
					);
				});
				Object.entries(peerEls).forEach(([k, el]) => {
					if (!el) return;
					const isDimmed = !state.activePeers.includes(k);
					const isFocused = state.focused === k;
					el.setAttribute(
						'class',
						'peer-group interactive-node' +
							(isDimmed ? ' dimmed' : '') +
							(isFocused ? ' focused' : ''),
					);
				});
				if (routeCode) routeCode.textContent = state.code;
				if (graphHint) graphHint.textContent = state.hint;
			}

			nodes.forEach((node) => {
				const key = node.getAttribute('data-peer');
				node.addEventListener('mouseenter', () => applyHover(key));
				node.addEventListener('focus', () => applyHover(key));
				node.addEventListener('click', () => applyHover(key));
				node.addEventListener('blur', () => applyHover('default'));
			});

			graph?.addEventListener('mouseleave', () => applyHover('default'));

			// Theme toggle
			const toggle = document.getElementById('theme-toggle');
			toggle?.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				document.documentElement.dataset.theme = next;
				localStorage.setItem('starlight-theme', next);
			});
		</script>

