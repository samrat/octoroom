---
import { Code } from 'astro:components';

const roomCode = `defmodule MyApp.CallRoom do
  use Octoroom.Room
  import Octoroom.Agent, only: [agent: 3]

  @impl true
  def join(%{"name" => name}, _socket), do: {:ok, %{name: name}}

  @impl true
  def workers(%{participants: []}), do: []

  def workers(room) do
    [
      agent("assistant", MyApp.Assistant,
        name: "Assistant",
        hears: Enum.map(room.participants, &mic/1),
        sees: Enum.flat_map(room.participants, &[camera(&1), screen(&1)]),
        respond: :addressed,
        args: %{workspace: room.assigns.workspace}
      )
    ]
  end
end`;

const agentCode = `defmodule MyApp.Assistant do
  use Octoroom.Agent
  alias Octoroom.Agent.Pipeline.Spec

  @impl true
  def instructions(ctx),
    do: "You are a voice assistant on a call for #{ctx.args.workspace}. Be brief."

  @impl true
  def tools(_ctx), do: [MyApp.Tools.set_theme()]

  @impl true
  def pipeline(_ctx) do
    Spec.default(
      stt: "soniox:stt-rt-v6",
      llm: "google:gemini-3.5-flash",
      tts: "tiny_voca:tiny-voca"
    )
    # Or speech-to-speech / audiovisual:
    # Spec.gemini_live(model: "gemini-3.8-live", voice: "Puck")
    # Spec.openai_live(model: "gpt-live-1.1", voice: "marin")
    # Spec.nuance_live(persona: "sam")
  end
end`;

const browserCode = `import { RoomClient } from "octoroom";
import { agents } from "octoroom_agents";

const room = new RoomClient({
  socket,
  topic: \`room:\${roomId}\`,
  params: { name: "Ada" },
  video: true,
});

room.on("participants", (list) => renderParticipants(list));
room.on("tracks", (tracks) => renderVideos(tracks));

const ai = agents(room);
ai.on("transcript", ({ agent, items }) => renderTranscript(agent, items));

await room.join(); // publishes mic/camera, plays server-subscribed audio`;

const swiftCode = `import Octoroom
import OctoroomAgents
import SwiftUI

struct CallView: View {
  let room: RoomClient     // @Observable
  let agents: Agents       // @Observable

  var body: some View {
    ForEach(room.tracks.filter { $0.kind == .video }) { track in
      VideoView(track)
    }
    ForEach(agents.agents) { agent in
      Text("\\(agent.name): \\(agent.state?.rawValue ?? "")")
    }
  }
}`;

const features = [
	{
		title: 'Cloudflare SFU as a commodity pipe',
		body: 'Outbound UDP only—no SFU cluster to operate, no TURN server, no open inbound ports. Cloudflare bills egress only ($0.05/GB after 1,000 GB/month free).',
	},
	{
		title: 'App-owned multi-party routing',
		body: 'Pure Elixir callbacks decide who hears and sees whom—per-track gain, whisper tracks, data-only outputs, and dynamic server-side workers.',
	},
	{
		title: 'Survives restarts and deploys',
		body: 'Signed resume tokens adopt existing Cloudflare sessions with zero WebRTC renegotiation. Workers checkpoint state and restart cleanly.',
	},
	{
		title: 'Cascaded & live AI agents',
		body: 'Run Silero VAD, SmartTurn, Soniox/AssemblyAI/Reson8 STT, ReqLLM, local TinyVoca ONNX TTS—or swap to Gemini Live, OpenAI Live, or Nuance Live avatars.',
	},
	{
		title: 'Zero-npm JS & native Swift SDK',
		body: 'Drop-in browser ES modules (octoroom.mjs) plus a native iOS 17+ and macOS 14+ SwiftPM SDK speaking the exact same Phoenix channel protocol.',
	},
	{
		title: 'Accurate barge-in & offline tests',
		body: 'Paced Opus outlets report exact dropped_ms on interruption so agent history matches what humans heard. Full Elixir, JS, and Swift suites run 100% offline.',
	},
];

const examples = [
	{
		name: 'examples/call',
		tag: 'Zero accounts needed',
		desc: 'LiveView group video call with echo, metronome, and recording workers—runs locally via Octoroom.Cloudflare.Local.',
		href: 'https://github.com/samrat/octoroom/tree/main/examples/call',
	},
	{
		name: 'examples/vision',
		tag: 'Camera + Screen',
		desc: 'Voice + vision agent that sees your camera and shared screen, switching between Cascaded (TinyVoca) and Gemini Live mid-call.',
		href: 'https://github.com/samrat/octoroom/tree/main/examples/vision',
	},
	{
		name: 'examples/agent',
		tag: 'Latency & Pipelines',
		desc: '1-on-1 voice agent timing every turn end-to-end as heard in the browser, plus a deterministic scripted booking agent.',
		href: 'https://github.com/samrat/octoroom/tree/main/examples/agent',
	},
	{
		name: 'examples/meet',
		tag: 'Multi-Agent',
		desc: 'Group video call with multiple AI assistants, decision-model routing, and the live Voice Timeline latency waterfall.',
		href: 'https://github.com/samrat/octoroom/tree/main/examples/meet',
	},
	{
		name: 'examples/ios',
		tag: 'SwiftUI',
		desc: 'Native iOS app joining the exact same Phoenix rooms and speaking to the same AI agents.',
		href: 'https://github.com/samrat/octoroom/tree/main/examples/ios',
	},
];
